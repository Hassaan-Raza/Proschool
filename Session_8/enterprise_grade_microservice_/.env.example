# .env.example

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=mydatabase

# Service Configuration
SERVICE_NAME=my-service
SERVICE_PORT=8080
SERVICE_HOST=localhost

# Authentication Configuration
AUTH_JWT_SECRET=secretkey
AUTH_JWT_EXPIRATION=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/my-service.log

# Testing Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=password
TEST_DB_NAME=mytestdatabase

# Deployment Configuration
DEPLOYMENT_ENV=dev
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
DEPLOYMENT_AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
DEPLOYMENT_AWS_REGION=us-east-1

# Security Configuration
SECURITY_SSL_ENABLED=false
SECURITY_SSL_CERTIFICATE=/path/to/certificate.crt
SECURITY_SSL_KEY=/path/to/private/key.key

# Monitoring Configuration
MONITORING_PROMETHEUS_ENABLED=true
MONITORING_PROMETHEUS_HOST=localhost
MONITORING_PROMETHEUS_PORT=9090
